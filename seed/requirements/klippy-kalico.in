# Klippy venv, Kalico flavor. Input to `uv pip compile` (see ../tools/lock.sh).
#
# Starts from Kalico's scripts/klippy-requirements.txt (tag pinned in release.lock). Deviations:
#   cffi==1.17.1 (no cp314 wheel)  -> cffi>=2.1, which has cp314 aarch64 wheels (the image carries cffi 2.0.0)
#   markupsafe==2.1.5              -> markupsafe 3.x (cp314 wheels)
#   everything else (greenlet 3.3, numpy 2.3, pyserial 3.4, python-can 4.6) as upstream.
greenlet~=3.3.0
cffi>=2.1,<3
Jinja2>=3.1.6
markupsafe>=3.0,<4
numpy~=2.3.0
pyserial==3.4
python-can~=4.6
# Moonraker's update manager calls "<venv>/bin/python -m pip"; keep it equal to the image's pip.
pip==25.3
