[Unit]
Description=Klarity - open screen daemon for the QIDI X-Plus 4 touchscreen
Documentation=https://github.com/eitri-fw/eitri/tree/main/klarity
After=network.target moonraker.service
Wants=moonraker.service
ConditionPathExists=/data/eitri/klarity/venv/bin/klarity
ConditionPathExists=/data/printer_data/config/klarity.cfg

[Service]
Type=simple
User=eitri
Group=eitri
# dialout owns the UART; the supplementary groups also match the eitri user's login groups.
SupplementaryGroups=dialout
WorkingDirectory=/data/eitri/klarity
ExecStart=/data/eitri/klarity/venv/bin/klarity -c /data/printer_data/config/klarity.cfg
# SIGTERM makes the daemon print its learn summary and exit cleanly.
KillSignal=SIGTERM
TimeoutStopSec=10
# EX_CONFIG (78): bad config / unset serial port -- restarting cannot fix that.
RestartPreventExitStatus=78
Restart=on-failure
RestartSec=3
# Moonraker/Klipper being down is normal; Klarity reconnects by itself, so no ordering
# failure should take the screen down.

# Hardening: Klarity needs the UART, loopback HTTP/websocket and its own log directory.
# "Unlock setup" (Decision 8) runs `sudo -n /usr/bin/eitri-configurator unlock` and
# `systemctl start eitri-configurator`, so this unit cannot set NoNewPrivileges (it would stop the
# setuid sudo from working). It also cannot use any option that systemd implements with seccomp
# (ProtectKernelTunables, ProtectKernelModules, RestrictNamespaces, LockPersonality, RestrictAddressFamilies,
# MemoryDenyWriteExecute, SystemCallFilter): they make systemd set NoNewPrivs on the process even with
# NoNewPrivileges=false, because the service user cannot install a filter without it (measured on the QEMU image,
# os/qemu/smoke.py checks /proc/<pid>/status). So only the mount, device and cgroup sandbox options are used.
# The only sudoers rule that reaches Klarity is that one command; /data/eitri/configurator is the
# directory that command writes its maintenance flag into, so it is writable here too (ProtectSystem
# is inherited by the sudo child).  Set `enabled: false` in klarity.cfg [unlock] if you do not want it.
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/data/printer_data/logs /data/eitri/configurator
ProtectHome=true
RuntimeDirectory=klarity
PrivateTmp=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-ttyS rw
DeviceAllow=char-ttyAMA rw
DeviceAllow=char-ttyUSB rw
ProtectControlGroups=true
UMask=0027
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
