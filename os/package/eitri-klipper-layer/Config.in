config BR2_PACKAGE_EITRI_KLIPPER_LAYER
	bool "eitri-klipper-layer"
	select BR2_PACKAGE_PYTHON3
	help
	  The Eitri Klipper layer: the qd_* extras, the printer.cfg
	  template, the macros and scripts/overlay-install.sh, built from
	  the klipper-layer/ directory of this repository and installed as
	  /usr/lib/eitri/klipper-layer. The configurator renders printer.cfg
	  from it and links the extras into the Klipper/Kalico clone on
	  /data; nothing in that clone is ever modified.
