# Buildroot configuration fragment: build the bootloader with Rockchip's
# proprietary DRAM-init blob (rkbin) instead of the open in-tree TPL.
#
# Applied on top of eitri_plus4_defconfig by "make -C os ddrbin-config". The
# default image does not use it. See docs/boot-chain.md for when you need it.
#
# The blob is fetched by Buildroot's rockchip-rkbin package at the commit pinned
# in Buildroot 2026.02 and copied next to U-Boot as ROCKCHIP_TPL. It is a
# Rockchip binary with a proprietary licence and is never committed here.
BR2_PACKAGE_ROCKCHIP_RKBIN=y
BR2_PACKAGE_ROCKCHIP_RKBIN_TPL_FILENAME="bin/rk33/rk3328_ddr_333MHz_v1.21.bin"
BR2_TARGET_UBOOT_NEEDS_ROCKCHIP_RKBIN=y
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EITRI_PATH)/board/eitri-plus4/uboot.fragment $(BR2_EXTERNAL_EITRI_PATH)/board/eitri-plus4/uboot-ddrbin.fragment"
