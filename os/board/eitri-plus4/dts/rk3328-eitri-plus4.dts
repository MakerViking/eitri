// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * QIDI X-Plus 4 host board: a Makerbase MKS-PI (Rockchip RK3328), which is a
 * ROC-RK3328-CC derivative.
 *
 * The mainline ROC-RK3328-CC device tree is the base. This file overrides only
 * what differs on the QIDI board. Every difference below was read from the
 * device tree that the stock image ships (model "Makerbase mks-pi") and from
 * the upstream tree it is applied to, and none of it has been booted yet:
 * rk3328-roc-cc.dts and this file must be validated on the bench, from a
 * microSD card, before any image is written to the eMMC.
 *
 *   - Ethernet: the MKS-PI uses the SoC's internal 100 Mbit PHY (gmac2phy).
 *     The ROC-CC's external RGMII PHY (gmac2io) is not populated.
 *   - UARTs: uart0 and uart1 are enabled next to uart2, giving ttyS0, ttyS1
 *     and ttyS2. They carry the two MCUs and the touchscreen; which board is
 *     on which port is decided at run time, so none of them is a console (the
 *     ROC-CC debug console is uart2).
 *   - Power switches: the microSD VCC switch is active high, the USB host 5 V
 *     enable is GPIO0_PA2, and the SD I/O voltage select is GPIO2_PC4. The
 *     ROC-CC drives these from different pins and polarities.
 */

#include "rockchip/rk3328-roc-cc.dts"

/ {
	model = "QIDI X-Plus 4 (Makerbase MKS-PI, RK3328)";
	compatible = "qidi,x-plus4", "firefly,roc-rk3328-cc", "rockchip,rk3328";

	aliases {
		ethernet0 = &gmac2phy;
	};

	/*
	 * The UARTs belong to the MCUs and the screen. Without stdout-path the
	 * kernel never selects one as a console even if "console=" is absent.
	 */
	chosen {
		/delete-property/ stdout-path;
	};
};

&gmac2io {
	status = "disabled";
};

&gmac2phy {
	status = "okay";
};

/*
 * uart0 uses TX/RX and CTS only on this board; RTS stays a GPIO. uart1 keeps
 * the full upstream pin group.
 */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_xfer &uart0_cts>;
	status = "okay";
};

&uart1 {
	status = "okay";
};

&pinctrl {
	sd {
		sdmmc_vqmmc_pin: sdmmc-vqmmc-pin {
			rockchip,pins = <2 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb2 {
		/* USB host VBUS enable moved from GPIO1_PD2 to GPIO0_PA2. */
		usb20_host_drv: usb20-host-drv {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&vcc_host1_5v {
	gpio = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
};

&vcc_sd {
	gpio = <&gpio0 RK_PD6 GPIO_ACTIVE_HIGH>;
};

&vcc_sdio {
	gpios = <&gpio2 RK_PC4 GPIO_ACTIVE_HIGH>;
	states = <1800000 0x0>, <3300000 0x1>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_vqmmc_pin>;
};
