# Eitri U-Boot environment. This file replaces U-Boot's built-in default
# environment completely (BR2_TARGET_UBOOT_DEFAULT_ENV_FILE), so every
# variable the boot needs is defined here. It is compiled in and never saved.
#
# Format (mkenvimage): one name=value per line. Lines that start with '#' and
# blank lines are dropped. A line that ends in a backslash continues on the
# next line; the backslash, the line break and the next line's leading
# whitespace are removed and nothing is added, so every command ends in ';'
# and every continued line ends in " \" with a space before the backslash.
#
# Boot flow
#   1. Try the microSD slot first (mmc 1), then the eMMC (mmc 0). Pulling a
#      bench SD card therefore reverts to the eMMC at once.
#   2. eMMC: A/B slots as used by RAUC. BOOT_ORDER names the slots in priority
#      order and BOOT_<slot>_LEFT counts the remaining attempts. Each try
#      decrements the counter and writes the state back; userspace resets it
#      after a healthy boot ("rauc status mark-good"). A slot that keeps
#      failing runs out of attempts and the next one is used.
#   3. microSD: always slot A, and nothing is written, so a bench boot leaves
#      the eMMC untouched.
#   4. Each slot is an ext4 partition that holds its own kernel and device
#      tree in /boot, so an update replaces kernel and rootfs together.
#
# A/B state is one text sector at eitri_state_blk on the eMMC (sector 8128,
# between the idbloader and u-boot.itb). Userspace reads and writes the same
# sector in /usr/libexec/eitri/rauc-bootloader. Only the four variables named
# below are ever imported from it; a missing or garbled sector means defaults.
#
# Optional /boot/firmware (FAT, partition 1) file "eitri-boot.env" may set
# eitri_extra_bootargs and eitri_force_slot; nothing else is imported from it.

bootdelay=0
silent=1
stdin=serial
stdout=serial
stderr=serial

# Memory layout (identical to include/configs/rk3328_common.h).
scriptaddr=0x00500000
fdt_addr_r=0x01e00000
fdtoverlay_addr_r=0x01f00000
kernel_addr_r=0x02080000
ramdisk_addr_r=0x06000000

fdtfile=rk3328-eitri-plus4.dtb

# GPT layout, see genimage.cfg: 1 boot (FAT), 2 rootfs A, 3 rootfs B, 4 data.
eitri_part_boot=1
eitri_part_A=2
eitri_part_B=3

# U-Boot numbers the eMMC 0 and the microSD slot 1. Linux numbers them the
# other way round (mmcblk1 is the eMMC), because the device tree aliases do.
eitri_emmc_dev=0
eitri_sd_dev=1

# 0x3F8000 / 512. Keep in sync with rootfs-overlay/usr/libexec/eitri/rauc-bootloader.
eitri_state_blk=0x1fc0

bootcmd=run eitri_boot

eitri_boot=for eitri_dev in ${eitri_sd_dev} ${eitri_emmc_dev}; do \
    if mmc dev ${eitri_dev}; then \
        run eitri_try_dev; \
    fi; \
done; \
echo "Eitri: no bootable slot found, resetting"; \
sleep 3; \
reset;

eitri_try_dev=run eitri_load_overrides; \
if test ${eitri_dev} = ${eitri_emmc_dev}; then \
    run eitri_select_slot; \
else \
    setenv eitri_slot A; \
    echo "Eitri: booting slot A from the microSD card (bench mode)"; \
fi; \
if test -n "${eitri_slot}"; then \
    run eitri_boot_slot; \
fi;

eitri_load_overrides=setenv eitri_extra_bootargs; \
setenv eitri_force_slot; \
if load mmc ${eitri_dev}:${eitri_part_boot} ${scriptaddr} eitri-boot.env; then \
    env import -t ${scriptaddr} ${filesize} eitri_extra_bootargs eitri_force_slot; \
fi;

eitri_state_load=setenv BOOT_ORDER; \
setenv BOOT_A_LEFT; \
setenv BOOT_B_LEFT; \
setenv EITRI_STATE; \
mw.b ${scriptaddr} 0 0x200; \
if mmc read ${scriptaddr} ${eitri_state_blk} 1; then \
    env import -t ${scriptaddr} 0x200 BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT EITRI_STATE; \
fi; \
if test "${EITRI_STATE}" != "1"; then \
    echo "Eitri: no valid boot state, using defaults"; \
    setenv BOOT_ORDER "A B"; \
    setenv BOOT_A_LEFT 3; \
    setenv BOOT_B_LEFT 3; \
fi; \
setenv EITRI_STATE 1;

eitri_state_save=mw.b ${scriptaddr} 0 0x200; \
env export -t ${scriptaddr} BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT EITRI_STATE; \
mmc write ${scriptaddr} ${eitri_state_blk} 1;

eitri_select_slot=setenv eitri_slot; \
run eitri_state_load; \
if test "${eitri_force_slot}" = "A" -o "${eitri_force_slot}" = "B"; then \
    setenv eitri_slot ${eitri_force_slot}; \
    echo "Eitri: slot ${eitri_slot} forced by eitri-boot.env"; \
else \
    for eitri_try in ${BOOT_ORDER}; do \
        if test -z "${eitri_slot}"; then \
            if test "${eitri_try}" = "A" -a ${BOOT_A_LEFT} -gt 0; then \
                setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; \
                setenv eitri_slot A; \
            fi; \
            if test "${eitri_try}" = "B" -a ${BOOT_B_LEFT} -gt 0; then \
                setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; \
                setenv eitri_slot B; \
            fi; \
        fi; \
    done; \
    if test -n "${eitri_slot}"; then \
        echo "Eitri: trying slot ${eitri_slot} (A: ${BOOT_A_LEFT} left, B: ${BOOT_B_LEFT} left)"; \
        run eitri_state_save; \
    else \
        echo "Eitri: every slot is out of attempts, restoring the counters"; \
        setenv BOOT_A_LEFT 3; \
        setenv BOOT_B_LEFT 3; \
        run eitri_state_save; \
        reset; \
    fi; \
fi;

eitri_boot_slot=if test "${eitri_slot}" = "A"; then setenv eitri_rootpart ${eitri_part_A}; else setenv eitri_rootpart ${eitri_part_B}; fi; \
if test ${eitri_dev} = ${eitri_emmc_dev}; then setenv eitri_linux_dev 1; else setenv eitri_linux_dev 0; fi; \
setenv bootargs "root=/dev/mmcblk${eitri_linux_dev}p${eitri_rootpart} ro rootwait rootfstype=ext4 rauc.slot=${eitri_slot} eitri.disk=/dev/mmcblk${eitri_linux_dev} net.ifnames=0 panic=10 loglevel=4 ${eitri_extra_bootargs}"; \
if ext4load mmc ${eitri_dev}:${eitri_rootpart} ${kernel_addr_r} /boot/Image; then \
    if ext4load mmc ${eitri_dev}:${eitri_rootpart} ${fdt_addr_r} /boot/${fdtfile}; then \
        booti ${kernel_addr_r} - ${fdt_addr_r}; \
    fi; \
fi; \
echo "Eitri: slot ${eitri_slot} on mmc ${eitri_dev} failed to load or boot";
