// Eitri: what the unprivileged "eitri" user, which runs Moonraker and the
// configurator, may ask the system to do. Everything not listed here keeps the
// default polkit policy (administrator authentication, which nobody can give).

polkit.addRule(function(action, subject) {
    if (subject.user !== "eitri") {
        return polkit.Result.NOT_HANDLED;
    }

    var units = [
        "klipper.service",
        "moonraker.service",
        "klarity.service",
        "eitri-camera.service",
        "go2rtc.service",
        "eitri-configurator.service",
        "nginx.service",
        "NetworkManager.service",
        "chrony.service",
        "rauc.service"
    ];

    // Start, stop, restart, enable and disable the Eitri services, and reload
    // systemd after a unit file changed.
    if (action.id === "org.freedesktop.systemd1.manage-units" ||
        action.id === "org.freedesktop.systemd1.manage-unit-files") {
        var unit = action.lookup("unit");
        if (unit !== undefined && units.indexOf(unit) >= 0) {
            return polkit.Result.YES;
        }
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }

    // Reboot and shut down from the web UI and the touchscreen.
    if (action.id.indexOf("org.freedesktop.login1.reboot") === 0 ||
        action.id.indexOf("org.freedesktop.login1.power-off") === 0) {
        return polkit.Result.YES;
    }

    // Host name, time zone and NTP from the configurator.
    if (action.id.indexOf("org.freedesktop.hostname1.set-") === 0 ||
        action.id.indexOf("org.freedesktop.timedate1.set-") === 0) {
        return polkit.Result.YES;
    }

    // Wi-Fi and Ethernet profiles.
    if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
