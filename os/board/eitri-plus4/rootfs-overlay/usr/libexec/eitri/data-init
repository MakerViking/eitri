#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Create or repair the layout of the /data partition.
#
# Runs after /data is mounted, on every boot, and only creates what is missing.
# On the first boot it builds the whole tree. It never deletes anything.
#
#   /data
#     firmware/{klipper,moonraker}   pinned clones from the data seed; owned by eitri
#     venv/{klippy,moonraker}        virtual environments from the data seed
#     printer_data/{config,logs,gcodes,database,comms}
#     eitri/{extras,klarity,toolchain,configurator,home}
#     eitri/admin                    the administrator's home; owned by admin, 0700
#     eitri/camera                   the RTSP credentials (go2rtc); owned by eitri, 0700
#     eitri/{klipper-layer,seed,flavor}   from the data seed (seed/SPEC.md section 3)
#     eitri/state/                   OS state, root only (etc overlay, RAUC, seed-installed.env)
#     eitri/logs/                    eitri-update event log (update.jsonl), root only
#
# The data seed itself is not unpacked here. It arrives before the first boot (the flash-once image's
# /data is populated by mkdata.sh at build time; the in-place installer's stage 2 installs it), or
# eitri-seed.service unpacks an archive that the image carries. This script has to cope with all of
# these: it adopts a tree that already exists, never replaces or merges into it, and only repairs
# the ownership of the parent directories that a root-run installer may have created.
#
# Environment overrides, used by the tests: EITRI_DATA, EITRI_FACTORY,
# EITRI_BOOTFS, EITRI_OWNER, EITRI_ADMIN, EITRI_RUN, EITRI_NO_RESIZE, EITRI_PYTHON,
# EITRI_CONFIGURATOR_SRC.

set -eu

DATA=${EITRI_DATA:-/data}
FACTORY=${EITRI_FACTORY:-/usr/share/eitri/factory}
BOOTFS=${EITRI_BOOTFS:-/boot/firmware}
OWNER=${EITRI_OWNER:-eitri:eitri}
ADMIN=${EITRI_ADMIN:-admin:admin}
RUN=${EITRI_RUN:-/run/eitri}
PYTHON=${EITRI_PYTHON:-python3}
CONFIGURATOR_SRC=${EITRI_CONFIGURATOR_SRC:-/usr/lib/eitri/configurator}
LAYOUT_VERSION=1

log() { echo "data-init: $*"; }

if [ -z "${EITRI_DATA:-}" ] && ! mountpoint -q "$DATA"; then
	mkdir -p "$RUN"
	echo "$DATA is not mounted" >"$RUN/degraded"
	log "$DATA is not mounted, skipping"
	exit 0
fi

# dir OWNER MODE PATH...
dir() {
	owner=$1
	mode=$2
	shift 2
	for d in "$@"; do
		if [ ! -d "$d" ]; then
			install -d -m "$mode" "$d"
			[ -z "$owner" ] || chown "$owner" "$d"
		fi
	done
}

# seed SRC DEST: copy a factory default, never overwriting the user's file.
seed() {
	if [ -f "$1" ] && [ ! -e "$2" ]; then
		install -m 0644 "$1" "$2"
		chown "$OWNER" "$2"
		log "installed default $2"
	fi
}

# The layout-version file is written last, so a /data that was pre-populated with the data seed (which
# already has eitri/state/seed-installed.env) or interrupted halfway still counts as a first boot.
first_boot=0
[ -e "$DATA/eitri/state/layout-version" ] || first_boot=1

# Root-only OS state. The etc overlay directories must exist before eitri-etc
# mounts the overlay.
dir "" 0755 "$DATA/eitri" "$DATA/eitri/state" "$DATA/eitri/state/etc" \
	"$DATA/eitri/state/etc/upper" "$DATA/eitri/state/etc/work" \
	"$DATA/eitri/logs"

# The application layer belongs to the service user.
dir "$OWNER" 0755 \
	"$DATA/firmware" \
	"$DATA/venv" "$DATA/venv/klippy" "$DATA/venv/moonraker" \
	"$DATA/printer_data" "$DATA/printer_data/config" "$DATA/printer_data/logs" \
	"$DATA/printer_data/gcodes" "$DATA/printer_data/database" "$DATA/printer_data/comms" \
	"$DATA/eitri/extras" "$DATA/eitri/klarity" "$DATA/eitri/toolchain" \
	"$DATA/eitri/configurator" "$DATA/eitri/home"
chmod 0750 "$DATA/eitri/home"

# The camera's RTSP credentials: outside printer_data/config, which Moonraker serves to the network.
dir "$OWNER" 0700 "$DATA/eitri/camera"

# The administrator's home (sudoers.d/admin). Its SSH keys are NOT kept here but in the root-owned
# eitri/state/access, so neither the administrator's own files nor the service user decide who logs in.
dir "$ADMIN" 0700 "$DATA/eitri/admin"

# MCU firmware: root delivers the signed firmware into mcu/firmware (eitri-update, stage 2); the flasher's backups and
# board map live in mcu/state, which the service user owns (the configurator runs eitri-mcuflash as that user). The
# parent stays root's, so that account cannot swap firmware/ for a link and steer what root writes there.
dir "" 0755 "$DATA/eitri/mcu" "$DATA/eitri/mcu/firmware"
dir "$OWNER" 0755 "$DATA/eitri/mcu/state"
if [ "$(ls -ldn "$DATA/eitri/mcu/state" | awk '{print $3}')" = 0 ]; then
	chown "$OWNER" "$DATA/eitri/mcu/state" 2>/dev/null || log "could not chown $DATA/eitri/mcu/state"
fi

# Parent directories of the seed's components belong to the service user (eitri-update's upstream mode
# and the configurator write below them). A root-run installer (mkdir -p) creates them as root; fix only
# those, only when they are root-owned, and never recurse.
for parent in "$DATA/firmware" "$DATA/venv" "$DATA/eitri/klarity"; do
	# (ls -ldn, not stat: the image's BusyBox has no stat applet - the rehearsal of the in-place install caught
	# "stat: command not found" here, which left the seed's parents owned by root)
	if [ -d "$parent" ] && [ "$(ls -ldn "$parent" | awk '{print $3}')" = 0 ]; then
		chown "$OWNER" "$parent" 2>/dev/null || log "could not chown $parent"
	fi
done

seed "$FACTORY/moonraker.asvc" "$DATA/printer_data/moonraker.asvc"
seed "$FACTORY/camera/go2rtc.yaml" "$DATA/printer_data/config/go2rtc.yaml"
seed "$FACTORY/camera/camera.env.example" "$DATA/printer_data/config/camera.env.example"

# The configurator runs from a virtual environment on /data, like the other
# application-layer programs, so that the app layer can update it. A first
# environment is created here from the copy that ships in the image: it sees
# the image's Python packages (aiohttp) and puts the image's
# eitri_configurator on its path last, so a newer package installed into the
# environment takes precedence. Created once, never replaced.
venv="$DATA/eitri/configurator/venv"
if [ ! -x "$venv/bin/python" ] && [ -d "$CONFIGURATOR_SRC" ]; then
	if "$PYTHON" -m venv --without-pip --system-site-packages "$venv"; then
		for site in "$venv"/lib/python3*/site-packages; do
			printf '%s\n' "$CONFIGURATOR_SRC" >"$site/eitri-image.pth"
		done
		chown -R "$OWNER" "$venv"
		log "created $venv"
	else
		log "could not create $venv"
		rm -rf "$venv"
	fi
fi

# Web UI served by nginx (root /data/eitri/ui/current). /data/eitri is root's, so the service user's configurator
# cannot create or replace entries in it: eitri/ui is a directory of its own, and `current` inside it is the symlink
# the configurator switches between the two UIs. An older layout had eitri/ui itself as the symlink; keep its choice.
if [ -L "$DATA/eitri/ui" ]; then
	old=$(readlink "$DATA/eitri/ui")
	rm -f "$DATA/eitri/ui"
	dir "$OWNER" 0755 "$DATA/eitri/ui"
	ln -s "$old" "$DATA/eitri/ui/current"
	chown -h "$OWNER" "$DATA/eitri/ui/current"
	log "converted the eitri/ui link into a directory (still $old)"
fi
dir "$OWNER" 0755 "$DATA/eitri/ui"
if [ ! -e "$DATA/eitri/ui/current" ] && [ ! -L "$DATA/eitri/ui/current" ]; then
	ln -s /usr/share/eitri/ui/fluidd "$DATA/eitri/ui/current"
	chown -h "$OWNER" "$DATA/eitri/ui/current"
fi

# Small files that the configurator (service user) and root tools both write. They are files of the service user's
# because it cannot create files in root's eitri/. eitri/flavor comes from the data seed (never made up here: a
# placeholder would disagree with a kalico seed installed later); eitri/channel is made here. Whoever replaces them
# as root must keep the owner (eitri-update does).
if [ ! -e "$DATA/eitri/channel" ]; then
	echo eitri >"$DATA/eitri/channel"
	chown "$OWNER" "$DATA/eitri/channel"
fi

# SSH keys dropped on the boot partition by a PC. Only well-formed key lines
# are accepted, and each is added once.
keys="$BOOTFS/authorized_keys"
if [ -f "$keys" ]; then
	ssh_dir="$DATA/eitri/home/.ssh"
	dir "$OWNER" 0700 "$ssh_dir"
	target="$ssh_dir/authorized_keys"
	[ -e "$target" ] || install -m 0600 -o "${OWNER%%:*}" -g "${OWNER##*:}" /dev/null "$target"
	added=0
	while IFS= read -r line; do
		case "$line" in
		ssh-* | ecdsa-* | sk-ssh-* | sk-ecdsa-*)
			if ! grep -qxF -- "$line" "$target"; then
				printf '%s\n' "$line" >>"$target"
				added=$((added + 1))
			fi
			;;
		esac
	done <"$keys"
	[ "$added" -eq 0 ] || log "added $added SSH key(s) from $keys"
fi

if [ ! -e "$DATA/eitri/state/layout-version" ]; then
	echo "$LAYOUT_VERSION" >"$DATA/eitri/state/layout-version"
fi
if [ "$first_boot" -eq 1 ]; then
	# First setup may add SSH keys for the administrator (eitri-access admin-set-key) until the
	# configurator finishes and closes this window. It is opened here and nowhere else, on the first
	# boot of a fresh /data only, so nothing running later as the service user can open it again.
	dir "" 0755 "$DATA/eitri/state/access"
	: >"$DATA/eitri/state/access/admin-window"
	chmod 0644 "$DATA/eitri/state/access/admin-window"
	log "first boot: first-setup window for administrator keys is open"
	{
		date -u +%Y-%m-%dT%H:%M:%SZ
		[ ! -r /etc/os-release ] || sed -n 's/^VERSION_ID=//p' /etc/os-release
	} >"$DATA/eitri/state/first-boot"
	log "first boot: created the /data layout"
fi

# The partition was enlarged before it was mounted (grow-data); grow the file
# system to match. A no-op when it already fills the partition.
if [ -z "${EITRI_NO_RESIZE:-}" ]; then
	source_dev=$(findmnt -n -o SOURCE "$DATA" 2>/dev/null || true)
	if [ -b "$source_dev" ]; then
		resize2fs "$source_dev" >/dev/null 2>&1 || log "resize2fs failed on $source_dev"
	fi
fi
exit 0
