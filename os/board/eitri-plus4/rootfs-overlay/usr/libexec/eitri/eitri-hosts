#!/usr/bin/python3 -I
# SPDX-License-Identifier: Apache-2.0
"""eitri-hosts: the extra host names nginx answers to, from the printer's configuration files.

nginx (etc/nginx/nginx.conf) serves the printer only under names it can legitimately be reached by: IP
addresses, single-label names (eitri, printer) and *.local. That refuses DNS rebinding, where a web page names
a domain it controls that resolves to the printer. A name such as printer.home.arpa from the router's DNS has
to be listed, one per line, in

    /data/printer_data/config/eitri-hosts.txt      (the setup wizard writes it; Fluidd/Mainsail can edit it)

That file belongs to the service user, so it is only data here: every entry must be a valid DNS name and is
written into /etc/nginx/eitri-hosts.map as one quoted map key, never copied as configuration text. The new map
is checked with `nginx -t` and the previous one is put back if nginx refuses it, so a bad file can never take
the web interface down. eitri-hosts.path runs this when the file changes; eitri-hosts.service also runs it at
every boot, before nginx. Invalid entries are skipped and reported on stderr (the journal).

Exit status: 0 applied (or nothing to do); 1 nginx refused the new map (the old one is kept).
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

# Test hooks, honoured only when this runs unprivileged (systemd starts it as root with a clean environment).
_TESTING = os.geteuid() != 0
ROOT = Path(os.environ["EITRI_HOSTS_ROOT"]) if _TESTING and os.environ.get("EITRI_HOSTS_ROOT") else Path("/")
NGINX = os.environ["EITRI_HOSTS_NGINX"].split() if _TESTING and os.environ.get("EITRI_HOSTS_NGINX") else ["nginx"]
SYSTEMCTL = os.environ["EITRI_HOSTS_SYSTEMCTL"] if _TESTING and os.environ.get("EITRI_HOSTS_SYSTEMCTL") else "systemctl"

SOURCE = ROOT / "data/printer_data/config/eitri-hosts.txt"
MAP = ROOT / "etc/nginx/eitri-hosts.map"
MAX_SOURCE = 16384
MAX_NAMES = 32
LABEL = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
NAME = re.compile(rf"{LABEL}(?:\.{LABEL})*")
HEADER = ("# Extra host names nginx answers to, besides IP addresses, single-label names and *.local.\n"
          "# Generated by /usr/libexec/eitri/eitri-hosts from /data/printer_data/config/eitri-hosts.txt;\n"
          "# edit that file, not this one. One exact name per line, in nginx map syntax.\n")


def parse(text: str) -> tuple[list[str], list[str]]:
    """The valid names (lowercased, in order, without duplicates) and the rejected entries."""
    names: list[str] = []
    rejected: list[str] = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0]
        for entry in re.split(r"[\s,]+", line.strip()):
            if not entry:
                continue
            name = entry.lower().rstrip(".")
            if len(name) > 253 or not NAME.fullmatch(name):
                rejected.append(entry[:80])
            elif name not in names:
                names.append(name)
    if len(names) > MAX_NAMES:
        rejected.extend(names[MAX_NAMES:])
        names = names[:MAX_NAMES]
    return names, rejected


def render(names: list[str]) -> str:
    return HEADER + "".join(f'"{name}" 1;\n' for name in names)


def write_atomic(path: Path, data: str) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def nginx_accepts() -> bool:
    try:
        return subprocess.run([*NGINX, "-t", "-q"], capture_output=True, timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def reload_nginx() -> None:
    try:
        if subprocess.run([SYSTEMCTL, "is-active", "--quiet", "nginx.service"], timeout=20).returncode == 0:
            subprocess.run([SYSTEMCTL, "reload", "--no-block", "nginx.service"], timeout=30, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"eitri-hosts: cannot reload nginx: {exc}", file=sys.stderr)


def main() -> int:
    try:
        with open(SOURCE, "rb") as fh:
            text = fh.read(MAX_SOURCE + 1).decode("utf-8", errors="replace")
    except FileNotFoundError:
        text = ""
    if len(text) > MAX_SOURCE:
        print(f"eitri-hosts: {SOURCE} is larger than {MAX_SOURCE} bytes; only its start is read", file=sys.stderr)
        text = text[:MAX_SOURCE]
    names, rejected = parse(text)
    for entry in rejected:
        print(f"eitri-hosts: skipped {entry!r}: not a valid host name (or more than {MAX_NAMES} names)", file=sys.stderr)
    wanted = render(names)
    try:
        previous = MAP.read_text()
    except FileNotFoundError:
        previous = None
    if previous == wanted:
        return 0
    write_atomic(MAP, wanted)
    if not nginx_accepts():
        if previous is not None:
            write_atomic(MAP, previous)
        else:
            write_atomic(MAP, render([]))
        print("eitri-hosts: nginx refused the new names; the previous ones are kept", file=sys.stderr)
        return 1
    print(f"eitri-hosts: nginx now also answers to: {', '.join(names) or '(no extra names)'}", file=sys.stderr)
    reload_nginx()
    return 0


if __name__ == "__main__":
    os.umask(0o022)
    sys.exit(main())
