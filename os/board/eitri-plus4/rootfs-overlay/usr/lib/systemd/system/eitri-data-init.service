[Unit]
Description=Create or repair the /data layout
Documentation=file:///usr/share/doc/eitri/os/README.md
DefaultDependencies=no
Wants=data.mount
After=data.mount
Before=eitri-etc.service sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/eitri/data-init

[Install]
WantedBy=sysinit.target
