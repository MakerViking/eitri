[Unit]
Description=Grow the Eitri data partition to the end of the disk
Documentation=file:///usr/share/doc/eitri/os/README.md
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/eitri/grow-data

[Install]
WantedBy=local-fs.target
