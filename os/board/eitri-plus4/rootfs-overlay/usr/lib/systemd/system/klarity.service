[Unit]
Description=Klarity touchscreen daemon (open replacement for xindi)
Documentation=file:///data/eitri/klarity/README.md
After=moonraker.service eitri-camera.service
Wants=moonraker.service
# Needs the venv that the installer creates, and a configured serial_port
# (klarity.cfg has no default until the panel's UART has been probed).
ConditionPathExists=/data/eitri/klarity/venv/bin/klarity
ConditionPathExists=/data/printer_data/config/klarity.cfg

[Service]
Type=simple
User=eitri
Group=eitri
SupplementaryGroups=dialout
ExecStart=/data/eitri/klarity/venv/bin/klarity --config /data/printer_data/config/klarity.cfg
Restart=on-failure
RestartSec=5
# Exit status 78 is a configuration error (for example an unset serial_port);
# restarting would not fix it.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
