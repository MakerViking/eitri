[Unit]
Description=Eitri configurator (first-run and maintenance web UI)
Documentation=file:///usr/share/doc/eitri/os/README.md
After=network.target eitri-data-init.service eitri-etc.service
Wants=eitri-data-init.service
# eitri-data-init creates this environment from the copy of the configurator in
# the image. configurator/systemd/eitri-configurator.service replaces this unit
# at build time when the component provides one.
ConditionPathExists=/data/eitri/configurator/venv/bin/python

[Service]
Type=simple
User=eitri
Group=eitri
SupplementaryGroups=dialout video
WorkingDirectory=/data/eitri/configurator
ExecStart=/data/eitri/configurator/venv/bin/python -m eitri_configurator --host 0.0.0.0 --port 8099
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
