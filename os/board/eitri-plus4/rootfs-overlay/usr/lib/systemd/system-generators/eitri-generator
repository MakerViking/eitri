#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# systemd generator: create the mount units for the partitions that live on the
# same disk as the root filesystem.
#
# U-Boot passes eitri.disk=/dev/mmcblkN on the kernel command line. The eMMC
# is mmcblk1 and a bench microSD card is mmcblk0, and the data partition has to
# follow the disk that was booted, so these mounts cannot be static fstab lines.
#
#   partition 1  vfat  /boot/firmware  read-only
#   partition 4  ext4  /data           read-write, checked with fsck first
#
# Another boot manager (for example the in-place installer, whose disk has a
# different partition map) names the devices explicitly instead:
#
#   eitri.data=SPEC        the /data partition
#   eitri.bootfs=SPEC      the FAT boot options partition
#   eitri.bootmount=PATH   where the FAT partition is mounted (default /boot/firmware)
#
# SPEC is /dev/..., PARTUUID=..., UUID=... or LABEL=.... An explicit value wins
# over the one derived from eitri.disk.
#
# Both mounts are "wanted", never "required", by local-fs.target: a damaged data
# partition must not stop the system from booting into a state where it can be
# diagnosed over the network.
#
# Usage: eitri-generator NORMAL_DIR [EARLY_DIR LATE_DIR]
# Environment override for tests: EITRI_CMDLINE (default /proc/cmdline).

set -eu

normal=${1:?usage: eitri-generator NORMAL_DIR}
cmdline=${EITRI_CMDLINE:-/proc/cmdline}

disk=
data_spec=
boot_spec=
boot_mount=/boot/firmware
# shellcheck disable=SC2013  # words of the command line, split on purpose
for word in $(cat "$cmdline"); do
	case "$word" in
	eitri.disk=*) disk=${word#eitri.disk=} ;;
	eitri.data=*) data_spec=${word#eitri.data=} ;;
	eitri.bootfs=*) boot_spec=${word#eitri.bootfs=} ;;
	eitri.bootmount=*) boot_mount=${word#eitri.bootmount=} ;;
	esac
done

case "$disk" in
'') ;;
/dev/mmcblk[0-9]) [ -n "$data_spec" ] || data_spec=${disk}p4; [ -n "$boot_spec" ] || boot_spec=${disk}p1 ;;
/dev/sd[a-z]) [ -n "$data_spec" ] || data_spec=${disk}4; [ -n "$boot_spec" ] || boot_spec=${disk}1 ;;
*)
	echo "eitri-generator: unsupported eitri.disk=$disk" >&2
	exit 0
	;;
esac

# Nothing to derive: not started by an Eitri boot script.
[ -n "$data_spec" ] || [ -n "$boot_spec" ] || exit 0

# Turn a PARTUUID=/UUID=/LABEL= spec into a device path, as fstab-generator does.
# Only characters that cannot break a unit file are accepted.
device_path() {
	case "$1" in
	PARTUUID=*) set -- "/dev/disk/by-partuuid/${1#PARTUUID=}" ;;
	UUID=*) set -- "/dev/disk/by-uuid/${1#UUID=}" ;;
	LABEL=*) set -- "/dev/disk/by-label/${1#LABEL=}" ;;
	esac
	case "$1" in
	/dev/*[!A-Za-z0-9/_.:+-]* | *..*)
		echo "eitri-generator: refusing device '$1'" >&2
		return 1
		;;
	/dev/?*) echo "$1" ;;
	*)
		echo "eitri-generator: not a device: '$1'" >&2
		return 1
		;;
	esac
}

# Unit name for a path, e.g. /dev/mmcblk1p4 -> dev-mmcblk1p4.
escape_path() {
	if command -v systemd-escape >/dev/null 2>&1; then
		systemd-escape --path "$1"
	else
		path=${1#/}
		echo "$path" | tr / -
	fi
}

wants="$normal/local-fs.target.wants"
mkdir -p "$wants"

if [ -n "$data_spec" ] && data=$(device_path "$data_spec"); then
	data_esc=$(escape_path "$data")
	fsck_unit="systemd-fsck@${data_esc}.service"

	cat >"$normal/data.mount" <<UNIT
# Generated by eitri-generator
[Unit]
Description=Eitri data partition
Documentation=file:///usr/share/doc/eitri/os/README.md
Wants=eitri-grow-data.service
After=eitri-grow-data.service
Requires=$fsck_unit
After=$fsck_unit

[Mount]
What=$data
Where=/data
Type=ext4
Options=noatime
UNIT
	ln -sf ../data.mount "$wants/data.mount"

	# The partition has to be enlarged before it is checked and mounted.
	mkdir -p "$normal/$fsck_unit.d"
	cat >"$normal/$fsck_unit.d/10-eitri-grow.conf" <<UNIT
[Unit]
Wants=eitri-grow-data.service
After=eitri-grow-data.service
UNIT
fi

case "$boot_mount" in
/*[!A-Za-z0-9/_.-]* | *..*) boot_spec= ;;
/?*) ;;
*) boot_spec= ;;
esac

if [ -n "$boot_spec" ] && bootfs=$(device_path "$boot_spec"); then
	unit=$(escape_path "$boot_mount").mount
	cat >"$normal/$unit" <<UNIT
# Generated by eitri-generator
[Unit]
Description=Eitri boot options partition
Documentation=file:///usr/share/doc/eitri/os/README.md

[Mount]
What=$bootfs
Where=$boot_mount
Type=vfat
Options=ro,noatime,nodev,nosuid,noexec,umask=0077
UNIT
	ln -sf "../$unit" "$wants/$unit"
fi
