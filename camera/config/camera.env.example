# Site overrides for eitri-camera.service.
# Copy to /data/printer_data/config/camera.env (the unit reads that path; it is optional).
# Changes take effect after: systemctl restart eitri-camera
#
# Resolution (1920x1080) and format (MJPEG passthrough) are fixed in the unit by design.

# Camera node. The udev rule provides /dev/eitri-cam; override only for debugging.
# The unit only starts when /dev/eitri-cam exists (ConditionPathExists). For another node,
# also add a drop-in (systemctl edit eitri-camera) containing:  [Unit]  ConditionPathExists=
#EITRI_CAMERA_DEVICE=/dev/eitri-cam

# How long the wait step polls for the node at boot or hotplug, in seconds.
#EITRI_CAMERA_WAIT_SECONDS=20

# auto (default): leave the camera's auto-exposure running. The frame-rate lock is still applied.
# manual: fixed exposure, in 100 microsecond units. At 30 fps, keep this <= 333
#         (1/30 s), or the sensor drops below 30 fps in low light.
#EITRI_CAMERA_EXPOSURE_MODE=auto
#EITRI_CAMERA_EXPOSURE_ABS=250

# Mains flicker compensation: off | 50 | 60 | auto. Unset leaves the camera's own setting.
#EITRI_CAMERA_POWER_LINE=50
