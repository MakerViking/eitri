# Stable device node for the Eitri camera: /dev/eitri-cam.
#
# Links only the capture node (interface index 0). The metadata node of the same
# UVC device (index 1) is left alone, so /dev/eitri-cam always means video.
#
# Rule 1: the known camera, Sunplus 1bcf:0b09. Also starts eitri-camera.service on
#         hotplug (SYSTEMD_WANTS); the unit's own ExecStartPre waits for the node.
# Rule 2: generic fallback for any other USB UVC capture device. Requires a USB
#         parent (ATTRS{idVendor}) so Rockchip ISP/codec platform nodes never match.
#         If two UVC cameras are attached, the fallback is ambiguous: keep rule 1's
#         camera plugged in or pin the other device by its own rule.
#
# Requires 60-persistent-v4l.rules (systemd) for ID_V4L_CAPABILITIES; it runs first.

SUBSYSTEM=="video4linux", KERNEL=="video*", ATTR{index}=="0", ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="0b09", SYMLINK+="eitri-cam", GROUP="video", MODE="0660", TAG+="systemd", ENV{SYSTEMD_WANTS}+="eitri-camera.service"

SUBSYSTEM=="video4linux", KERNEL=="video*", ATTR{index}=="0", ATTRS{idVendor}=="?*", ENV{ID_V4L_CAPABILITIES}==":capture:", SYMLINK+="eitri-cam", GROUP="video", MODE="0660", TAG+="systemd"
