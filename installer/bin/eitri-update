#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Run eitri-update from a source checkout / unpacked installer (no pip install needed).
HERE=$(cd "$(dirname "$0")/.." && pwd)
exec python3 -I -c 'import sys; sys.path[:0] = [sys.argv[1], sys.argv[2]]; from eitri_update.cli import main; sys.exit(main(sys.argv[3:]))' "$HERE/eitri-update" "$HERE/mcuflash" "$@"
