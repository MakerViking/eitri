#!/bin/sh
# modprobe --show-depends NAME -> "insmod PATH" for the stock kernel's module under $EITRI_ROOT$FAKE_MODDIR (.ko or .ko.xz)
[ "$1" = "--show-depends" ] || exit 1
[ -n "$FAKE_MODDIR" ] || exit 0
for f in "$EITRI_ROOT$FAKE_MODDIR/$2.ko" "$EITRI_ROOT$FAKE_MODDIR/$2.ko.xz"; do
  [ -f "$f" ] && echo "insmod ${f#"$EITRI_ROOT"}"
done
exit 0
