# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml,lock}]
indent_size = 2

[*.{sh,bash}]
indent_size = 4

[*.cfg]
indent_size = 4

[{Makefile,*.mk,Config.in*}]
indent_style = tab

[*.mk]
indent_style = tab
